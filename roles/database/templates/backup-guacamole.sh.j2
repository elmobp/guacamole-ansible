#!/bin/bash
# {{ ansible_managed }}
# Guacamole MySQL database backup (reference: guac-management/backup-guacamole.sh)
set -euo pipefail
export PATH=/bin:/usr/bin:/usr/local/bin

MYSQL_HOST="{{ guac_mysql_host }}"
MYSQL_PORT="{{ guac_mysql_port }}"
GUAC_USER="{{ guac_db_user }}"
GUAC_PWD="{{ guac_db_password }}"
GUAC_DB="{{ guac_db_name }}"
BACKUP_DIR="{{ guac_db_backup_dir }}"
RETENTION="{{ guac_db_backup_retention_days }}"
TODAY="$(date +%Y-%m-%d)"

mkdir -p "${BACKUP_DIR}"
find "${BACKUP_DIR}" -type f -name '*.gz' -mtime "+${RETENTION}" -delete

mysqldump -h "${MYSQL_HOST}" -P "${MYSQL_PORT}" -u "${GUAC_USER}" -p"${GUAC_PWD}" \
    "${GUAC_DB}" --single-transaction --quick --lock-tables=false \
    > "${BACKUP_DIR}/${GUAC_DB}-${TODAY}.sql"

gzip -f "${BACKUP_DIR}/${GUAC_DB}-${TODAY}.sql"
echo "$(date -Is) ${GUAC_DB} backup ok -> ${BACKUP_DIR}/${GUAC_DB}-${TODAY}.sql.gz"
