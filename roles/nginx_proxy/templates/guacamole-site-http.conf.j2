# {{ ansible_managed }}
# Guacamole reverse proxy — plain HTTP (reference: 3-install-nginx.sh)
# Used when guac_tls_mode is "none" or "letsencrypt" (certbot rewrites this to add 443).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
{% if guac_ipv6_available | default(false) %}
    listen [::]:80 default_server;
{% endif %}
    server_name {{ guac_le_dns_name if guac_tls_mode == 'letsencrypt' and guac_le_dns_name | length > 0 else guac_proxy_site }};

    location / {
        proxy_pass {{ guac_proxy_upstream }};
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        access_log off;
    }
}
