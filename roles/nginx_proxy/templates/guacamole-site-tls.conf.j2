# {{ ansible_managed }}
# Guacamole reverse proxy — self-signed TLS 1.3 (reference: 4a-install-tls-self-signed-nginx.sh)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name {{ guac_proxy_site }};

    ssl_certificate     {{ guac_ssl_cert_dir }}/{{ guac_proxy_site }}.crt;
    ssl_certificate_key {{ guac_ssl_key_dir }}/{{ guac_proxy_site }}.key;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass {{ guac_proxy_upstream }};
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        access_log off;
    }
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}
